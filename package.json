{
  "name": "betta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "concurrently -n next,server \"next dev\" \"node --watch server/index.ts\"",
    "dev:mobile": "concurrently -n next,server \"next dev --experimental-https -H 0.0.0.0\" \"node --watch server/index.ts --https\"",
    "dev:tunnel": "node scripts/dev-tunnel.mjs",
    "build": "next build",
    "start": "next start",
    "deploy:server": "bash scripts/deploy-server.sh",
    "typecheck": "tsc --noEmit",
    "server": "node server/index.ts"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@mediapipe/tasks-vision": "^1.2.0",
    "@next/mdx": "16.4.3",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "next": "16.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "three": "^0.186.1",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2"
  }
}
